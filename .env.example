# =============================================================================
# OpenCode Free Relay - example environment
# Copy to `.env` and edit. Every value can also be set from the admin panel
# unless it is marked as "env only".
# =============================================================================

APP_NAME="OpenCode Free Relay"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://relay.example.com
# Generate with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_KEY=change-me-to-a-64-character-random-hex-string

# --- PostgreSQL -------------------------------------------------------------
# Either set DATABASE_URL or the individual values below.
# DATABASE_URL="pgsql:host=127.0.0.1;port=5432;dbname=opencode_relay;user=relay;password=secret"
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=opencode_relay
DB_USER=relay
DB_PASSWORD=secret
DB_SSLMODE=prefer

# --- Session / cookies ------------------------------------------------------
SESSION_NAME=ocrelay_session
SESSION_LIFETIME=86400
SESSION_SECURE=auto
# Set to true only when the relay is behind a trusted reverse proxy.
TRUST_PROXY=false

# --- OpenCode upstream ------------------------------------------------------
# Free models are exposed by OpenCode under this base URL.
OPENCODE_BASE_URL=https://opencode.ai/inference
OPENCODE_MODELS_URL=https://opencode.ai/inference/v1/models
# Free models need NO real API key. The official client still sends the
# literal placeholder "public" (`Authorization: Bearer public`) when the user
# has no Console key. Keep it for parity; set to a real oc_sk_... key only if
# you intentionally want authenticated Console behavior. Set empty to omit the
# header entirely.
OPENCODE_UPSTREAM_KEY=public
# Keep these in sync with the official client. `bin/sync-client-version.php`
# can refresh the version from npm automatically.
OPENCODE_CLIENT_NAME=cli
OPENCODE_CLIENT_CHANNEL=latest
OPENCODE_CLIENT_VERSION=1.19.6
# The official 1.19.6 CLI sends this exact UA. Keep it in sync with the build
# you are mirroring; OPENCODE_CLIENT_VERSION alone does not change the UA.
OPENCODE_USER_AGENT="opencode/1.19.6 ai-sdk/provider-utils/4.0.23 runtime/bun/1.4.4"
# Number of fresh IPv6 addresses to try when OpenCode replies 429/5xx or when
# the selected source address cannot be bound.
OPENCODE_MAX_IP_RETRIES=2
OPENCODE_CONNECT_TIMEOUT=15
OPENCODE_TIMEOUT=900
# Comma-separated allowlist; empty means allow any upstream host.
OPENCODE_ALLOWED_HOSTS=opencode.ai

# Free-channel request shaping ------------------------------------------
# The free channel only accepts requests shaped like the official client:
# exact official system-prompt prefix, a `read` tool, and stream=true.
# The prefix/tool schema shipped in resources/opencode/ were exported from an
# official 1.19.6 build. Override the directory if you update the client.
OPENCODE_SHAPE_REQUESTS=true
OPENCODE_SHAPE_DIR=
OPENCODE_PROJECT_ID=global

# --- Bun upstream bridge ----------------------------------------------------
# Site libcurl often fails upstream transport admission (even with a valid
# body). When set, PHP forwards through bin/opencode-bridge.ts instead of
# connecting to opencode.ai directly. Leave empty to use direct IPv6 mode.
# The bridge's BRIDGE_TOKEN must equal OPENCODE_BRIDGE_TOKEN.
# OPENCODE_BRIDGE_URL=http://127.0.0.1:18130
# OPENCODE_BRIDGE_TOKEN=replace-with-a-random-token

# --- IPv6 policy ------------------------------------------------------------
# Kept for compatibility. The relay always enforces IPv6: no IPv4 fallback.
IPV6_REQUIRED=true
# Keep leases for this long so a recently used address is not selected again.
IPV6_DEFAULT_LEASE_TTL=604800
# interface (CURLOPT_INTERFACE) or opensocket (requires ext-sockets).
IPV6_BIND_METHOD=interface
# Allow ::1/128 pools for local development. Leave false in production.
IPV6_ALLOW_LOOPBACK=false
# Used by bin/doctor.php for the source-bind probe. It must resolve to AAAA.
IPV6_PROBE_URL=https://opencode.ai/inference/v1/models

# --- Cron / retention -------------------------------------------------------
CRON_SECRET=change-me
MODEL_SYNC_INTERVAL=3600
LOG_RETENTION_DAYS=30
LEASE_RETENTION_DAYS=7

# --- Optional defaults (can be changed in the admin panel) ------------------
REGISTRATION_MODE=open
DEFAULT_PLAN=free
REQUIRE_APPROVAL=false
PUBLIC_MODEL_LIST=true
AUTO_ENABLE_NEW_FREE_MODELS=true
